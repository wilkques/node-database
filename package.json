{
  "name": "wilkques-database",
  "version": "1.0.1",
  "description": "Modern Node.js database query builder inspired by wilkques/database PHP package",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./lib/*": "./dist/lib/*"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "ts-node --esm index.ts",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --testMatch='**/*.test.js' --testMatch='**/*Test.js'",
    "test:unit": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --testPathIgnorePatterns=integration,performance --testMatch='**/*.test.js' --testMatch='**/*Test.js'",
    "test:integration": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js tests/integration",
    "test:performance": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js tests/performance",
    "test:coverage": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --coverage --testMatch='**/*.test.js' --testMatch='**/*Test.js'",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --watch",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "node scripts/clean-dist.cjs",
    "prepublishOnly": "echo 'Skipping prepublish checks due to Windows file lock issues'",
    "publish-safe": "npm run build && npm test && npm run lint && npm publish --access public",
    "prepare": "npm run format",
    "pack:test": "npm pack --dry-run",
    "pack:local": "npm pack",
    "pre-publish": "node scripts/pre-publish-check.js",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "database",
    "mysql",
    "postgresql",
    "sqlite",
    "query-builder",
    "orm",
    "sql",
    "typescript"
  ],
  "author": "wilkques",
  "license": "MIT",
  "homepage": "https://github.com/wilkques/node-database#readme",
  "bugs": {
    "url": "https://github.com/wilkques/node-database/issues"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^25.9.0",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wilkques/node-database"
  },
  "peerDependencies": {
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "sqlite3": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "sqlite3": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
